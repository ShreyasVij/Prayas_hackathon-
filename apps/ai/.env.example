APP_NAME=MediLocker AI
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

INTERNAL_AUTH_TOKEN=change-me
WEB_BASE_URL=http://localhost:3000
# Optional comma-separated list. Falls back to WEB_BASE_URL.
ALLOW_ORIGINS=http://localhost:3000

# Runtime: mock | gemini | huggingface | local
AI_RUNTIME_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
HF_TOKEN=
HF_TEXT_MODEL=
HF_PROVIDER=auto
HF_BASE_URL=
LOCAL_AI_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_AI_MODEL=
RUNTIME_TIMEOUT=60
RUNTIME_RETRIES=2

OCR_SPACE_API_KEY=
OCR_SPACE_TIMEOUT=45

MONGODB_URI=
MONGODB_DB=medilocker

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=medilocker

MAX_UPLOAD_BYTES=15728640
MAX_FILES_PER_REQUEST=20
MAX_OCR_CHARS=30000
MAX_HEALTH_SUMMARY_CHARS=15000
MAX_TITLE_TEXT_CHARS=1000
MAX_REQUEST_BODY_BYTES=20971520
ARTIFACT_DOWNLOAD_TIMEOUT=60
